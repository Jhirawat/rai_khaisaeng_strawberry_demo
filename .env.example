APP_NAME="Rai Khaisaeng Strawberry"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://raikhaisaengstrawberrydemo-production.up.railway.app

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maeyangha_shop
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=file
QUEUE_CONNECTION=sync
CACHE_STORE=file
FILESYSTEM_DISK=public
MAIL_MAILER=log

# Social Login: ใส่ Client ID/Secret จริงของคุณเองในRailway Variables / .env ของเครื่องตัวเอง ห้ามใส่ Secret ลง GitHub
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=${APP_URL}/auth/facebook/callback

LINE_CLIENT_ID=
LINE_CLIENT_SECRET=
LINE_REDIRECT_URI=${APP_URL}/auth/line/callback

# v28 Production Safety
APP_ENV=production
APP_DEBUG=false
ALLOW_DEMO_SEED=false
